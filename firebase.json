{
  "$schema": "https://firebase.google.com/docs/firebase-hosting/schema.json",
  "database": {
    "rules": "firebase/database.rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20",
      "predeploy": ["npm run build:functions"]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/package-lock.json",
      "**/*.log"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/media/*/seg*.ts", "function": { "functionId": "app", "region": "us-central1" } },
      { "source": "/playout/**", "function": { "functionId": "app", "region": "us-central1" } },
      { "source": "/player_api.php", "function": { "functionId": "app", "region": "us-central1" } },
      { "source": "/panel_api.php", "function": { "functionId": "app", "region": "us-central1" } },
      { "source": "/get.php", "function": { "functionId": "app", "region": "us-central1" } },
      { "source": "/xmltv.php", "function": { "functionId": "app", "region": "us-central1" } },
      { "source": "/live/**", "function": { "functionId": "app", "region": "us-central1" } },
      { "source": "/movie/**", "function": { "functionId": "app", "region": "us-central1" } },
      { "source": "/series/**", "function": { "functionId": "app", "region": "us-central1" } },
      { "source": "/portal.php", "function": { "functionId": "app", "region": "us-central1" } },
      { "source": "/stalker_portal/**", "function": { "functionId": "app", "region": "us-central1" } },
      { "source": "/c", "destination": "/portal.html" },
      { "source": "/c/", "destination": "/portal.html" },
      { "source": "/c/index.html", "destination": "/portal.html" },
      { "source": "/c/portal.php", "function": { "functionId": "app", "region": "us-central1" } },
      { "source": "/c/**", "function": { "functionId": "app", "region": "us-central1" } },
      { "source": "/s/**", "function": { "functionId": "app", "region": "us-central1" } },
      { "source": "/api/**", "function": { "functionId": "app", "region": "us-central1" } },
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/admin/**", "destination": "/admin.html" },
      { "source": "/reseller", "destination": "/reseller.html" },
      { "source": "/reseller/**", "destination": "/reseller.html" },
      { "source": "/developers", "destination": "/developers.html" },
      { "source": "/guide", "destination": "/developers.html" },
      { "source": "/academy", "destination": "/academy.html" },
      { "source": "/academy/**", "destination": "/academy.html" }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
        ]
      },
      {
        "source": "/admin",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
        ]
      },
      {
        "source": "/admin.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
        ]
      },
      {
        "source": "/reseller",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/reseller.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/academy",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/academy.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/developers",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/developers.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/guide",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/portal.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/embed.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/media/**",
        "headers": [
          { "key": "Access-Control-Allow-Origin", "value": "*" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/embed.js",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      },
      {
        "source": "/favicon.ico",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
