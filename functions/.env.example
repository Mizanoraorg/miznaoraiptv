# Mizanora IPTV — Firebase Functions environment template.
# Copy to functions/.env (never commit .env) or set with:
#   firebase functions:config ... / Google Cloud console environment variables.
# The service account makes RTDB writes durable (rules-verified owner writes).
FIREBASE_DATABASE_URL=https://mizanoranet-default-rtdb.firebaseio.com
# Full service-account JSON (one line) OR the two fields below:
#FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"mizanoranet",...}
#FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@mizanoranet.iam.gserviceaccount.com
#FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# Strong production secrets (owner PIN + session/stream signing):
#MZ_OWNER_PIN=
#MZ_SESSION_SECRET=
#MZ_STREAM_SECRET=
# Fail writes loudly instead of using the /tmp mirror:
MZ_REQUIRE_PERSISTENCE=1
